# ── Fiscal Data API (public, no auth required) ────────────────────────
# Base URL — no changes needed unless Treasury rotates the endpoint
FISCAL_DATA_BASE_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service

# ── TRORBOT API Gateway (optional — enables KB retrieval tools) ────────
# Leave blank to run in "public-data-only" mode (Fiscal Data tools still work)
TRORBOT_API_URL=
TRORBOT_API_KEY=

# ── Server settings ────────────────────────────────────────────────────
# Transport: "stdio" for local Claude Desktop / Claude Code testing
#            "http"  for deployed HTTP/SSE mode (set by platform via PORT env var)
MCP_TRANSPORT=stdio
PORT=8080

# Request timeout in seconds
HTTP_TIMEOUT=30
