# ── Fiscal Data API (public, no auth required) ────────────────────────
# Base URL — no changes needed unless Treasury rotates the endpoint
FISCAL_DATA_BASE_URL=https://api.fiscaldata.treasury.gov/services/api/fiscal_service

# ── Knowledge bases on Amazon S3 Vectors (optional — enables KB tools) ─
# Leave TRORBOT_KB_BUCKET blank to run in "public-data-only" mode (Fiscal Data tools still work).
# AWS credentials come from TRORBOT_KB_AWS_PROFILE, or the standard AWS credential chain if blank.
TRORBOT_KB_BUCKET=
TRORBOT_KB_AWS_PROFILE=
TRORBOT_KB_REGION=us-east-1

# ── Server settings ────────────────────────────────────────────────────
# Transport: "stdio" for local Claude Desktop / Claude Code testing
#            "http"  for deployed HTTP/SSE mode (set by platform via PORT env var)
MCP_TRANSPORT=stdio
PORT=8080

# Request timeout in seconds
HTTP_TIMEOUT=30
